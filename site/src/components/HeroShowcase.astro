---
// Interactive 4-scene bmux workspace showcase for the landing page.
// Cycles through Agent sidebar, Session picker, Modeless copy & search,
// and Project & worktree picker. Supports ?scene=1..4 and ?capture=1.
---

<section class="hero-stage" id="stage" aria-label="Interactive bmux workspace tour">
	<div class="stage-topbar">
		<div class="stage-tabs" role="tablist">
			<button type="button" class="stage-tab is-active" data-scene-tab="1">
				<span>Agent sidebar</span>
				<span class="stage-tab-key">Ctrl-a i</span>
			</button>
			<button type="button" class="stage-tab" data-scene-tab="2">
				<span>Session picker</span>
				<span class="stage-tab-key">Ctrl-a s</span>
			</button>
			<button type="button" class="stage-tab" data-scene-tab="3">
				<span>Modeless copy &amp; search</span>
				<span class="stage-tab-key">Drag / Ctrl-a /</span>
			</button>
			<button type="button" class="stage-tab" data-scene-tab="4">
				<span>Project &amp; worktrees</span>
				<span class="stage-tab-key">Ctrl-a n</span>
			</button>
		</div>
		<button type="button" class="stage-play-btn" data-play-toggle>
			<span class="stage-play-dot"></span>
			<span data-play-label>Auto-play</span>
		</button>
		<div class="stage-progress-track"><div class="stage-progress-fill" data-progress></div></div>
	</div>

	<div class="term-shell">
		<div class="bmux-top">
			<div class="bmux-top-l">
				<span class="pl-brand">bmux</span>
				<span class="pl-sess" data-pl-sess>api</span>
				<span class="pl-pane" data-pl-pane>pane 1/3 · claude</span>
				<span class="pl-win is-alert" data-pl-win1>1 code!</span>
				<span class="pl-win" data-pl-win2>2 server</span>
			</div>
			<div class="bmux-top-r">
				<span class="pl-meta"><strong>git:main</strong> · 14:13:51</span>
			</div>
		</div>

		<!-- SCENE 1: AGENT SIDEBAR + LIVE APPROVAL -->
		<div class="term-scene bmux-layout is-active" data-scene="1">
			<aside class="bmux-side">
				<div>
					<div class="side-sec-label">SESSIONS</div>
					<div class="side-item is-cur"><span class="side-item-l"><span class="dot dot-rose" data-sess-dot></span>api</span></div>
					<div class="side-item is-wt"><span class="side-item-l">↳ fix-auth</span></div>
					<div class="side-item"><span class="side-item-l"><span class="dot-hollow"></span>web</span></div>
					<div class="side-item"><span class="side-item-l" style="padding-left:14px;">docs</span></div>
				</div>
				<div class="side-divider"></div>
				<div>
					<div class="side-sec-label">AGENTS 3</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot dot-rose" data-claude-dot></span>claude</span>
							<span class="st-blocked" data-claude-state>blocked</span>
						</div>
						<div class="side-agent-sub">api</div>
					</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot dot-amber"></span>codex</span>
							<span class="st-working"><span data-spinner>⠹</span> working</span>
						</div>
						<div class="side-agent-sub">api</div>
					</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot-hollow"></span>opencode</span>
							<span class="st-idle">idle</span>
						</div>
						<div class="side-agent-sub">web</div>
					</div>
				</div>
			</aside>

			<div class="split-main">
				<div class="pane-left">
					<div>
						<div class="pane-title">
							<span><strong>claude</strong> · ~/projects/api</span>
							<button type="button" class="pane-reset" data-claude-reset hidden>Reset prompt</button>
						</div>
						<div class="t-line"><span class="c-cyan">›</span> Run the server tests</div>
						<div class="t-line" style="margin-top:10px;"><span class="c-mint">●</span> Ran <strong>go build ./...</strong></div>
						<div class="t-line" data-claude-line2><span class="c-amber">●</span> Wants to run <strong>go test ./...</strong></div>

						<div data-claude-prompt>
							<div class="t-line c-rose" style="margin-top:14px; font-weight:700;">Allow this command?</div>
							<div class="prompt-opts">
								<button type="button" class="prompt-opt is-picked" data-approve="yes">❯ 1. Yes</button>
								<button type="button" class="prompt-opt" data-approve="always">&nbsp;&nbsp;2. Yes, don't ask again</button>
								<button type="button" class="prompt-opt" data-approve="no">&nbsp;&nbsp;3. No, tell claude why</button>
							</div>
						</div>
						<div data-claude-result hidden style="margin-top:14px;"></div>
					</div>
					<div class="pane-hint-pill" data-claude-hint>Interactive: click “1. Yes” to approve &amp; clear the blocked alert</div>
				</div>

				<div class="pane-right">
					<div class="pane-tr">
						<div class="pane-title"><span><strong>codex</strong> · ~/projects/api</span></div>
						<div class="t-line"><span class="c-cyan">›</span> Add a /health endpoint</div>
						<div class="t-line" style="margin-top:8px;"><span class="c-mint">•</span> Read router.go</div>
						<div class="t-line"><span class="c-mint">•</span> Edited health.go <span class="c-muted">(+42)</span></div>
						<div class="t-line"><span class="c-amber">•</span> Running go vet ./...</div>
						<div class="t-line c-amber" style="margin-top:8px;"><span data-spinner>⠹</span> Working <span class="c-muted">(18s · esc)</span></div>
					</div>
					<div class="pane-br">
						<div class="t-line c-muted">api $ git --no-pager log --oneline -4</div>
						<div class="t-line"><span class="c-amber">690680e</span> <span class="c-cyan">(HEAD -&gt; main)</span> Add /health endpoint</div>
						<div class="t-line"><span class="c-amber">ae385b8</span> Fix flaky restart test</div>
						<div class="t-line"><span class="c-amber">a07aa9e</span> Handle client reconnects</div>
						<div class="t-line" style="margin-top:4px;"><span class="c-mint">api $</span> <span class="cursor-blk"></span></div>
					</div>
				</div>
			</div>
		</div>

		<!-- SCENE 2: SESSION PICKER -->
		<div class="term-scene picker-scene" data-scene="2">
			<div class="picker-search">
				<span><strong>Sessions</strong> <span class="c-muted">(4) · /</span> <span class="cursor-blk"></span></span>
				<span class="c-muted">click a session to preview live</span>
			</div>
			<div class="picker-list">
				<button type="button" class="picker-row is-selected" data-sess-pick="api">
					<span><span class="c-rose">●</span> api — 2 windows, 4 panes</span>
					<span class="c-muted">claude blocked · codex working</span>
				</button>
				<button type="button" class="picker-row" data-sess-pick="fix-auth">
					<span>&nbsp;&nbsp;↳ api/fix-auth — 1 window, 2 panes</span>
					<span class="c-muted">worktree · tests passing</span>
				</button>
				<button type="button" class="picker-row" data-sess-pick="web">
					<span><span class="c-mint">○</span> web — 1 window, 1 pane</span>
					<span class="c-muted">opencode idle</span>
				</button>
				<button type="button" class="picker-row" data-sess-pick="docs">
					<span>&nbsp;&nbsp;docs — 1 window, 1 pane</span>
					<span class="c-muted">server.log</span>
				</button>
			</div>
			<div class="preview-box">
				<div class="preview-cap">
					<span data-prev-title>api · 1/1</span>
					<span class="c-muted">live terminal preview</span>
				</div>
				<div class="preview-body" data-prev-body>
					<div class="t-line"><strong>claude</strong> · ~/projects/api</div>
					<div class="t-line c-rose" style="margin-top:6px;">Allow this command?</div>
					<div class="t-line c-cyan">&nbsp;&nbsp;❯ 1. Yes &nbsp;&nbsp;(go test ./...)</div>
					<div class="t-line c-amber" style="margin-top:8px;">⠹ codex Working (18s) · Edited health.go (+42)</div>
				</div>
			</div>
		</div>

		<!-- SCENE 3: MODELESS COPY & SCROLLBACK SEARCH -->
		<div class="term-scene bmux-layout" data-scene="3">
			<aside class="bmux-side">
				<div>
					<div class="side-sec-label">SESSIONS</div>
					<div class="side-item is-cur"><span class="side-item-l">docs</span></div>
					<div class="side-item"><span class="side-item-l"><span class="dot-hollow"></span>web</span></div>
					<div class="side-item"><span class="side-item-l"><span class="dot dot-rose"></span>api</span></div>
				</div>
				<div class="side-divider"></div>
				<div>
					<div class="side-sec-label">AGENTS 3</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot-hollow"></span>opencode</span>
							<span class="st-idle">idle</span>
						</div>
						<div class="side-agent-sub">web</div>
					</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot dot-rose"></span>claude</span>
							<span class="st-blocked">blocked</span>
						</div>
						<div class="side-agent-sub">api</div>
					</div>
					<div class="side-agent">
						<div class="side-agent-top">
							<span class="side-item-l"><span class="dot dot-amber"></span>codex</span>
							<span class="st-working"><span data-spinner>⠹</span> working</span>
						</div>
						<div class="side-agent-sub">api</div>
					</div>
				</div>
			</aside>

			<div class="log-pane">
				<div class="log-bar">
					<span><span class="c-cyan">/timeout</span> <span class="c-muted">· 3/3 matches · [ ] prompt jumps</span></span>
					<span class="log-badge" data-osc-badge>✓ Copied selection via OSC 52</span>
				</div>
				<div class="log-lines">
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:01</span> <span class="c-mint">INFO </span> listening on :8080</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:04</span> <span class="c-mint">INFO </span> GET /api/users 200 12ms</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:07</span> <span class="c-amber">WARN </span> upstream <span class="hl-match">timeout</span> after 5s (GET /api/billing)</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:12</span> <span class="c-mint">INFO </span> POST /api/login 200 31ms</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:18</span> <span class="c-amber">WARN </span> slow query 812ms: SELECT * FROM sessions</button>
					<button type="button" class="log-line is-selected" data-log-line><span class="c-muted">12:00:24</span> <span class="c-rose">ERROR</span> upstream <span class="hl-match">timeout</span> after 5s (POST /api/invoices)</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:26</span> <span class="c-mint">INFO </span> POST /api/invoices 201 1220ms</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:36</span> <span class="c-amber">WARN </span> cache miss rate 41% over 60s</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:44</span> <span class="c-rose">ERROR</span> upstream <span class="hl-match">timeout</span> after 5s (GET /api/billing)</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:44</span> <span class="c-mint">INFO </span> circuit open for billing (30s)</button>
					<button type="button" class="log-line" data-log-line><span class="c-muted">12:00:50</span> <span class="c-mint">INFO </span> GET /health 200 1ms</button>
				</div>
				<div class="c-muted" style="font-size:11.5px; margin-top:4px;">Click any line to simulate mouse selection copy — soft-wrapped lines join automatically.</div>
			</div>
		</div>

		<!-- SCENE 4: PROJECT & WORKTREE PICKER -->
		<div class="term-scene proj-scene" data-scene="4">
			<div class="proj-tabs">
				<div class="proj-tab-pills">
					<span class="proj-pill is-cur">Projects</span>
					<span class="proj-pill">Create</span>
				</div>
				<span class="c-muted" style="font-size:12px;">roots = ["~/projects"] · git worktrees grouped</span>
			</div>
			<div>
				<button type="button" class="proj-row is-cur" data-proj-row data-proj-action="Enter attaches to existing session api">
					<span>~/projects/api <span class="proj-branch">main</span></span>
					<span class="proj-tag">session api</span>
				</button>
				<button type="button" class="proj-row" data-proj-row data-proj-action="Enter attaches to worktree session api/fix-auth">
					<span>&nbsp;&nbsp;↳ ~/worktrees/api-auth <span class="proj-branch">fix/auth</span></span>
					<span class="proj-tag">worktree</span>
				</button>
				<button type="button" class="proj-row" data-proj-row data-proj-action="Enter attaches to existing session web">
					<span>~/projects/web <span class="proj-branch">main</span></span>
					<span class="proj-tag">session web</span>
				</button>
				<button type="button" class="proj-row" data-proj-row data-proj-action="Enter creates session cli and loads .bmux.toml">
					<span>~/projects/cli <span class="proj-branch">main</span></span>
					<span class="proj-tag proj-tag-new">new session</span>
				</button>
				<button type="button" class="proj-row" data-proj-row data-proj-action="Enter creates session infra">
					<span>~/projects/infra <span class="proj-branch">main</span></span>
					<span class="proj-tag proj-tag-new">new session</span>
				</button>
			</div>
			<div class="pane-hint-pill" data-proj-hint>Enter attaches to existing session api</div>
		</div>

		<div class="bmux-bottom">
			<span data-bmux-foot-l>api | pane 1/3 · claude | Ctrl-a s sessions · Ctrl-h/j/k/l navigate · Click “1. Yes” to approve</span>
			<span data-bmux-foot-r>Ctrl-a ? keys</span>
		</div>
	</div>
</section>

<style>
	:global(body.capture-mode) *,
	:global(body.capture-mode) *::before,
	:global(body.capture-mode) *::after {
		transition: none !important;
		animation: none !important;
	}

	.hero-stage {
		--term-bg: #181825;
		--term-pane: #1e1e2e;
		--term-bar: #11111b;
		--term-border: #313244;
		--term-text: #cdd6f4;
		--term-sub: #a6adc8;
		--term-muted: #6c7086;
		--term-cyan: #74c7ec;
		--term-rose: #f38ba8;
		--term-amber: #f9e2af;
		--term-mint: #a6e3a1;

		margin: 26px auto 0;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 14px;
		background: #101118;
		overflow: hidden;
		text-align: left;
		box-shadow:
			0 32px 96px rgba(0, 0, 0, 0.7),
			0 0 0 1px rgba(255, 255, 255, 0.04) inset;
	}

	.stage-topbar {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 10px 14px;
		background: #0d0e14;
		border-bottom: 1px solid rgba(255, 255, 255, 0.09);
		overflow-x: auto;
	}
	.stage-tabs { display: flex; align-items: center; gap: 6px; flex-wrap: nowrap; }
	.stage-tab {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 12px;
		border-radius: 7px;
		font-size: 12.5px;
		font-weight: 500;
		color: #71717a;
		border: 1px solid transparent;
		white-space: nowrap;
		transition: all 0.15s ease;
	}
	.stage-tab:hover { color: #a1a1aa; background: rgba(255, 255, 255, 0.03); }
	.stage-tab.is-active {
		color: #fafafa;
		background: rgba(34, 211, 238, 0.08);
		border-color: rgba(34, 211, 238, 0.28);
	}
	.stage-tab-key {
		font-family: var(--mono);
		font-size: 11px;
		color: #22d3ee;
		opacity: 0.9;
	}
	.stage-play-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 10px;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.09);
		font-family: var(--mono);
		font-size: 11.5px;
		color: #a1a1aa;
		white-space: nowrap;
		transition: color 0.15s, border-color 0.15s;
	}
	.stage-play-btn:hover { color: #fafafa; border-color: rgba(255, 255, 255, 0.18); }
	.stage-play-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #22d3ee;
	}
	.stage-play-btn.is-paused .stage-play-dot { background: #71717a; }

	.stage-progress-track {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: transparent;
	}
	.stage-progress-fill {
		height: 100%;
		width: 0%;
		background: linear-gradient(90deg, rgba(34, 211, 238, 0.35), #22d3ee);
	}

	.term-shell {
		font-family: var(--mono);
		font-size: 13px;
		line-height: 1.5;
		color: var(--term-text);
		background: var(--term-pane);
	}

	.bmux-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		background: var(--term-bar);
		border-bottom: 1px solid var(--term-border);
		font-size: 12px;
		overflow-x: auto;
		white-space: nowrap;
	}
	.bmux-top-l, .bmux-top-r { display: flex; align-items: stretch; }
	.pl-brand {
		background: #74c7ec;
		color: #11111b;
		font-weight: 700;
		padding: 5px 12px;
	}
	.pl-sess {
		background: #313244;
		color: var(--term-text);
		font-weight: 600;
		padding: 5px 12px;
	}
	.pl-pane {
		background: #181825;
		color: var(--term-sub);
		padding: 5px 12px;
		border-right: 1px solid var(--term-border);
	}
	.pl-win { padding: 5px 11px; color: var(--term-muted); }
	.pl-win.is-alert {
		background: rgba(116, 199, 236, 0.22);
		color: #89dceb;
		font-weight: 600;
	}
	.pl-meta {
		padding: 5px 12px;
		color: var(--term-muted);
		border-left: 1px solid var(--term-border);
	}
	.pl-meta strong { color: var(--term-sub); font-weight: 500; }

	.term-scene { display: none; min-height: 365px; }
	.term-scene.is-active { display: grid; }

	.bmux-layout { grid-template-columns: 224px 1fr; }
	.bmux-side {
		background: var(--term-bg);
		border-right: 1px solid var(--term-border);
		padding: 12px 0;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.side-sec-label {
		padding: 0 14px 4px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--term-muted);
	}
	.side-item {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 3px 14px;
		font-size: 12.5px;
		color: var(--term-sub);
	}
	.side-item.is-cur {
		background: rgba(116, 199, 236, 0.1);
		color: var(--term-cyan);
		font-weight: 600;
	}
	.side-item.is-wt { padding-left: 24px; font-size: 12px; color: var(--term-muted); }
	.side-item-l { display: inline-flex; align-items: center; gap: 7px; }
	.dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; }
	.dot-rose { background: var(--term-rose); }
	.dot-amber { background: var(--term-amber); }
	.dot-hollow { width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--term-mint); flex-shrink: 0; }
	.side-divider { height: 1px; background: var(--term-border); margin: 0 12px; }
	.side-agent { padding: 4px 14px; }
	.side-agent-top { display: flex; justify-content: space-between; align-items: center; gap: 6px; font-size: 12.5px; }
	.side-agent-sub { padding-left: 14px; font-size: 11px; color: var(--term-muted); }
	.st-blocked { color: var(--term-rose); font-size: 11.5px; }
	.st-working { color: var(--term-amber); font-size: 11.5px; }
	.st-idle { color: var(--term-muted); font-size: 11.5px; }

	.split-main { display: grid; grid-template-columns: 1.08fr 1fr; background: var(--term-pane); }
	.pane-left {
		border-right: 1px solid var(--term-border);
		padding: 14px 18px;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.pane-right { display: grid; grid-template-rows: 1fr 1fr; }
	.pane-tr { border-bottom: 1px solid var(--term-cyan); padding: 14px 18px; }
	.pane-br {
		border-left: 2px solid var(--term-cyan);
		margin-left: -1px;
		padding: 12px 18px;
		background: rgba(17, 17, 27, 0.35);
	}
	.pane-title {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 12px;
		color: var(--term-sub);
		font-size: 12.5px;
	}
	.pane-title strong { color: var(--term-text); }
	.pane-reset {
		font-size: 11px;
		padding: 2px 8px;
		border-radius: 4px;
		border: 1px solid var(--term-border);
		color: var(--term-sub);
	}
	.pane-reset:hover { border-color: var(--term-cyan); color: var(--term-cyan); }
	.t-line { margin: 4px 0; font-size: 12.5px; }
	.c-cyan { color: var(--term-cyan); }
	.c-mint { color: var(--term-mint); }
	.c-amber { color: var(--term-amber); }
	.c-rose { color: var(--term-rose); }
	.c-sub { color: var(--term-sub); }
	.c-muted { color: var(--term-muted); }

	.prompt-opts { margin-top: 12px; display: flex; flex-direction: column; gap: 3px; }
	.prompt-opt {
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 5px 8px;
		border-radius: 5px;
		text-align: left;
		font-size: 12.5px;
		color: var(--term-text);
		transition: background 0.12s;
	}
	.prompt-opt:hover, .prompt-opt.is-picked { background: rgba(116, 199, 236, 0.14); color: var(--term-cyan); }
	.pane-hint-pill {
		margin-top: 14px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 9px;
		border-radius: 5px;
		background: rgba(34, 211, 238, 0.08);
		border: 1px solid rgba(34, 211, 238, 0.25);
		font-size: 11px;
		color: var(--term-cyan);
	}
	.cursor-blk {
		display: inline-block;
		width: 8px;
		height: 14px;
		background: var(--term-text);
		vertical-align: -2px;
	}

	.picker-scene { grid-template-columns: 1fr; padding: 14px 18px; gap: 14px; }
	.picker-search {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 7px 12px;
		background: var(--term-bar);
		border: 1px solid var(--term-border);
		border-radius: 6px;
		font-size: 12.5px;
	}
	.picker-list { border: 1px solid var(--term-border); border-radius: 6px; overflow: hidden; }
	.picker-row {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 7px 12px;
		font-size: 12.5px;
		text-align: left;
		border-bottom: 1px solid rgba(49, 50, 68, 0.55);
		transition: background 0.12s;
	}
	.picker-row:last-child { border-bottom: 0; }
	.picker-row:hover { background: rgba(255, 255, 255, 0.03); }
	.picker-row.is-selected { background: #e6e9ef; color: #11111b; font-weight: 600; }
	.picker-row.is-selected .c-muted { color: #4c4f69; }
	.preview-box {
		border: 1px solid var(--term-border);
		border-radius: 6px;
		background: var(--term-bg);
		overflow: hidden;
	}
	.preview-cap {
		display: flex;
		justify-content: space-between;
		padding: 5px 12px;
		background: #24273a;
		border-bottom: 1px solid var(--term-border);
		font-size: 11.5px;
		color: var(--term-text);
	}
	.preview-body { padding: 12px 14px; min-height: 138px; font-size: 12.5px; }

	.log-pane { padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
	.log-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 10px;
		padding: 6px 10px;
		background: var(--term-bar);
		border: 1px solid var(--term-border);
		border-radius: 6px;
		font-size: 12px;
		flex-wrap: wrap;
	}
	.log-badge {
		padding: 2px 8px;
		border-radius: 4px;
		background: rgba(166, 227, 161, 0.14);
		border: 1px solid rgba(166, 227, 161, 0.35);
		color: var(--term-mint);
		font-size: 11px;
	}
	.log-lines { display: flex; flex-direction: column; gap: 1px; font-size: 12px; }
	.log-line {
		width: 100%;
		text-align: left;
		padding: 2px 8px;
		border-radius: 3px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: background 0.1s;
	}
	.log-line:hover { background: rgba(255, 255, 255, 0.04); }
	.log-line.is-selected {
		background: rgba(116, 199, 236, 0.22);
		outline: 1px solid rgba(116, 199, 236, 0.45);
	}
	.hl-match {
		background: #74c7ec;
		color: #11111b;
		padding: 0 3px;
		border-radius: 2px;
		font-weight: 600;
	}

	.proj-scene { grid-template-columns: 1fr; padding: 16px 20px; gap: 14px; align-content: start; }
	.proj-tabs { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--term-border); padding-bottom: 10px; }
	.proj-tab-pills { display: flex; gap: 8px; font-size: 12.5px; }
	.proj-pill { padding: 4px 12px; border-radius: 5px; background: #24273a; color: var(--term-sub); }
	.proj-pill.is-cur { background: var(--term-cyan); color: #11111b; font-weight: 700; }
	.proj-row {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 9px 12px;
		border-radius: 5px;
		font-size: 12.5px;
		text-align: left;
		border: 1px solid transparent;
	}
	.proj-row:hover { background: rgba(255, 255, 255, 0.03); }
	.proj-row.is-cur { background: #e6e9ef; color: #11111b; font-weight: 600; }
	.proj-row.is-cur .proj-branch { color: #4c4f69; }
	.proj-branch { margin-left: 10px; font-size: 11.5px; color: var(--term-muted); }
	.proj-tag {
		padding: 2px 8px;
		border-radius: 4px;
		font-size: 11.5px;
		background: rgba(116, 199, 236, 0.16);
		color: var(--term-cyan);
	}
	.proj-row.is-cur .proj-tag { background: #74c7ec; color: #11111b; }
	.proj-tag-new { background: rgba(255, 255, 255, 0.05); color: var(--term-muted); }

	.bmux-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 6px 14px;
		background: var(--term-bar);
		border-top: 1px solid var(--term-border);
		font-size: 11.5px;
		color: var(--term-muted);
		gap: 12px;
		flex-wrap: wrap;
	}

	@media (max-width: 920px) {
		.bmux-layout, .split-main { grid-template-columns: 1fr; }
		.bmux-side { border-right: 0; border-bottom: 1px solid var(--term-border); }
		.pane-left { border-right: 0; border-bottom: 1px solid var(--term-border); }
	}
</style>

<script>
	const spinFrames = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];
	let spinIdx = 0;
	const params = new URLSearchParams(window.location.search);
	const isCapture = params.get('capture') === '1';
	if (isCapture) document.body.classList.add('capture-mode');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	if (!isCapture && !reduceMotion) {
		setInterval(() => {
			spinIdx = (spinIdx + 1) % spinFrames.length;
			document.querySelectorAll('[data-spinner]').forEach((el) => {
				el.textContent = spinFrames[spinIdx];
			});
		}, 90);
	}

	const SCENE_META: Record<string, {
		sess: string; pane: string; win1: string; win1Alert: boolean; win2: string; footL: string; footR: string;
	}> = {
		'1': {
			sess: 'api', pane: 'pane 1/3 · claude', win1: '1 code!', win1Alert: true, win2: '2 server',
			footL: 'api | pane 1/3 · claude | Ctrl-a s sessions · Ctrl-h/j/k/l navigate · Click “1. Yes” to approve',
			footR: 'Ctrl-a ? keys'
		},
		'2': {
			sess: 'sessions', pane: '4 active (1 worktree)', win1: 'j/k move', win1Alert: false, win2: 'Enter attach',
			footL: 'j/k ↑↓ · Enter attach · n new · d terminate · r rename · / search · Esc back',
			footR: 'Ctrl-a s'
		},
		'3': {
			sess: 'docs', pane: 'pane 1/1 · scrollback', win1: '1 logs', win1Alert: false, win2: 'OSC 52',
			footL: 'docs | Drag to copy on release · Scrollback: hjkl move · / ? search · [ ] prompts · v V Ctrl-v select',
			footR: 'Ctrl-a /'
		},
		'4': {
			sess: 'projects', pane: '5 repositories', win1: 'Projects', win1Alert: true, win2: 'Create',
			footL: 'Projects: type to filter · Up/Down select · Enter opens its session, or creates one',
			footR: 'Ctrl-a n'
		}
	};

	const stage = document.getElementById('stage');
	const sceneTabs = document.querySelectorAll<HTMLButtonElement>('[data-scene-tab]');
	const scenes = document.querySelectorAll<HTMLElement>('[data-scene]');
	const playBtn = document.querySelector<HTMLButtonElement>('[data-play-toggle]');
	const playLabel = document.querySelector<HTMLElement>('[data-play-label]');
	const progressEl = document.querySelector<HTMLElement>('[data-progress]');

	const reqScene = params.get('scene') ?? '';
	let currentScene = ['1', '2', '3', '4'].includes(reqScene) ? reqScene : '1';
	let autoPlay = !isCapture && !reduceMotion;
	let elapsed = 0;
	const DURATION = 5500;
	let claudeApproved = false;

	function applyPowerline(id: string) {
		const m = SCENE_META[id];
		if (!m) return;
		const sessEl = document.querySelector('[data-pl-sess]');
		const paneEl = document.querySelector('[data-pl-pane]');
		const w1 = document.querySelector('[data-pl-win1]');
		const w2 = document.querySelector('[data-pl-win2]');
		const footL = document.querySelector('[data-bmux-foot-l]');
		const footR = document.querySelector('[data-bmux-foot-r]');
		if (sessEl) sessEl.textContent = m.sess;
		if (paneEl) paneEl.textContent = m.pane;
		if (w1) {
			w1.textContent = id === '1' && claudeApproved ? '1 code' : m.win1;
			w1.classList.toggle('is-alert', m.win1Alert && !(id === '1' && claudeApproved));
		}
		if (w2) w2.textContent = m.win2;
		if (footL) footL.textContent = m.footL;
		if (footR) footR.textContent = m.footR;
	}

	function setScene(id: string) {
		currentScene = id;
		elapsed = 0;
		if (progressEl) progressEl.style.width = '0%';
		sceneTabs.forEach((t) => t.classList.toggle('is-active', t.dataset.sceneTab === id));
		scenes.forEach((s) => s.classList.toggle('is-active', s.dataset.scene === id));
		applyPowerline(id);
	}

	function updatePlayUI() {
		if (!playBtn || !playLabel) return;
		playBtn.classList.toggle('is-paused', !autoPlay);
		playLabel.textContent = autoPlay ? 'Auto-play' : 'Paused';
		if (!autoPlay && progressEl) progressEl.style.width = '0%';
	}

	sceneTabs.forEach((tab) => {
		tab.addEventListener('click', () => {
			autoPlay = false;
			updatePlayUI();
			if (tab.dataset.sceneTab) setScene(tab.dataset.sceneTab);
		});
	});

	playBtn?.addEventListener('click', () => {
		autoPlay = !autoPlay;
		elapsed = 0;
		updatePlayUI();
	});

	let hovering = false;
	stage?.addEventListener('mouseenter', () => { hovering = true; });
	stage?.addEventListener('mouseleave', () => { hovering = false; });

	if (!isCapture && !reduceMotion) {
		setInterval(() => {
			if (!autoPlay || hovering) return;
			elapsed += 100;
			if (progressEl) progressEl.style.width = `${Math.min(100, (elapsed / DURATION) * 100)}%`;
			if (elapsed >= DURATION) {
				setScene(String((Number(currentScene) % 4) + 1));
			}
		}, 100);
	}

	const claudePrompt = document.querySelector<HTMLElement>('[data-claude-prompt]');
	const claudeResult = document.querySelector<HTMLElement>('[data-claude-result]');
	const claudeReset = document.querySelector<HTMLButtonElement>('[data-claude-reset]');
	const claudeHint = document.querySelector<HTMLElement>('[data-claude-hint]');
	const claudeLine2 = document.querySelector<HTMLElement>('[data-claude-line2]');
	const claudeDot = document.querySelector<HTMLElement>('[data-claude-dot]');
	const sessDot = document.querySelector<HTMLElement>('[data-sess-dot]');
	const claudeState = document.querySelector<HTMLElement>('[data-claude-state]');

	function resetClaude() {
		claudeApproved = false;
		if (claudePrompt) claudePrompt.hidden = false;
		if (claudeResult) claudeResult.hidden = true;
		if (claudeReset) claudeReset.hidden = true;
		if (claudeLine2) claudeLine2.innerHTML = '<span class="c-amber">●</span> Wants to run <strong>go test ./...</strong>';
		if (claudeDot) claudeDot.className = 'dot dot-rose';
		if (sessDot) sessDot.className = 'dot dot-rose';
		if (claudeState) {
			claudeState.className = 'st-blocked';
			claudeState.textContent = 'blocked';
		}
		if (claudeHint) claudeHint.textContent = 'Interactive: click “1. Yes” to approve & clear the blocked alert';
		applyPowerline(currentScene);
	}

	document.querySelectorAll<HTMLButtonElement>('[data-approve]').forEach((btn) => {
		btn.addEventListener('click', () => {
			autoPlay = false;
			updatePlayUI();
			if (btn.dataset.approve === 'no') {
				if (claudeHint) claudeHint.textContent = 'Declined — claude waits for your next instruction.';
				return;
			}
			claudeApproved = true;
			if (claudePrompt) claudePrompt.hidden = true;
			if (claudeReset) claudeReset.hidden = false;
			if (claudeLine2) claudeLine2.innerHTML = '<span class="c-mint">●</span> Approved <strong>go test ./...</strong>';
			if (claudeDot) claudeDot.className = 'dot dot-amber';
			if (sessDot) sessDot.className = 'dot dot-amber';
			if (claudeState) {
				claudeState.className = 'st-working';
				claudeState.textContent = 'working';
			}
			if (claudeResult) {
				claudeResult.hidden = false;
				claudeResult.innerHTML = '<div class="t-line c-amber">⠹ Running go test ./...</div>';
			}
			if (claudeHint) claudeHint.textContent = 'Sidebar & alert badge updated live — running tests…';
			applyPowerline(currentScene);

			setTimeout(() => {
				if (!claudeApproved) return;
				if (claudeDot) claudeDot.className = 'dot-hollow';
				if (sessDot) sessDot.className = 'dot-hollow';
				if (claudeState) {
					claudeState.className = 'st-idle';
					claudeState.textContent = 'idle';
				}
				if (claudeResult) {
					claudeResult.innerHTML =
						'<div class="t-line"><span class="c-mint">✓ PASS</span> <span class="c-sub">ok internal/server 0.84s</span></div>' +
						'<div class="t-line"><span class="c-mint">✓ PASS</span> <span class="c-sub">ok internal/vt 0.31s</span></div>';
				}
				if (claudeHint) claudeHint.textContent = 'Tests passed — claude is idle and the window alert cleared.';
			}, 950);
		});
	});
	claudeReset?.addEventListener('click', resetClaude);

	const SESSION_PREVIEWS: Record<string, { title: string; html: string }> = {
		'api': {
			title: 'api · 1/1',
			html: '<div class="t-line"><strong>claude</strong> · ~/projects/api</div>' +
				'<div class="t-line c-rose" style="margin-top:6px;">Allow this command?</div>' +
				'<div class="t-line c-cyan">&nbsp;&nbsp;❯ 1. Yes &nbsp;&nbsp;(go test ./...)</div>' +
				'<div class="t-line c-amber" style="margin-top:8px;">⠹ codex Working (18s) · Edited health.go (+42)</div>'
		},
		'fix-auth': {
			title: 'api/fix-auth · 1/1',
			html: '<div class="t-line"><strong>worktree</strong> · ~/worktrees/api-auth (fix/auth)</div>' +
				'<div class="t-line c-mint" style="margin-top:6px;">✓ go test ./internal/auth — 14 passed in 0.42s</div>' +
				'<div class="t-line c-muted" style="margin-top:6px;">api/fix-auth $ git status -sb → ## fix/auth</div>'
		},
		'web': {
			title: 'web · 1/1',
			html: '<div class="t-line"><strong>opencode</strong> · ~/projects/web</div>' +
				'<div class="t-line c-mint" style="margin-top:6px;">✓ Updated the login form</div>' +
				'<div class="t-line c-muted">&nbsp;&nbsp;3 files changed, +58 -12</div>'
		},
		'docs': {
			title: 'docs · 1/1',
			html: '<div class="t-line"><strong>docs $</strong> cat server.log</div>' +
				'<div class="t-line c-amber" style="margin-top:6px;">12:00:07 WARN  upstream timeout after 5s (GET /api/billing)</div>' +
				'<div class="t-line c-rose">12:00:24 ERROR upstream timeout after 5s (POST /api/invoices)</div>'
		}
	};
	document.querySelectorAll<HTMLButtonElement>('[data-sess-pick]').forEach((row) => {
		row.addEventListener('click', () => {
			autoPlay = false;
			updatePlayUI();
			document.querySelectorAll('[data-sess-pick]').forEach((r) => r.classList.toggle('is-selected', r === row));
			const p = row.dataset.sessPick ? SESSION_PREVIEWS[row.dataset.sessPick] : undefined;
			if (p) {
				const t = document.querySelector('[data-prev-title]');
				const b = document.querySelector('[data-prev-body]');
				if (t) t.textContent = p.title;
				if (b) b.innerHTML = p.html;
			}
		});
	});

	const oscBadge = document.querySelector<HTMLElement>('[data-osc-badge]');
	document.querySelectorAll<HTMLButtonElement>('[data-log-line]').forEach((line) => {
		line.addEventListener('click', () => {
			autoPlay = false;
			updatePlayUI();
			document.querySelectorAll('[data-log-line]').forEach((l) => l.classList.toggle('is-selected', l === line));
			if (oscBadge) oscBadge.textContent = '✓ Copied line via OSC 52';
		});
	});

	const projHint = document.querySelector<HTMLElement>('[data-proj-hint]');
	document.querySelectorAll<HTMLButtonElement>('[data-proj-row]').forEach((row) => {
		row.addEventListener('click', () => {
			autoPlay = false;
			updatePlayUI();
			document.querySelectorAll('[data-proj-row]').forEach((r) => r.classList.toggle('is-cur', r === row));
			if (projHint && row.dataset.projAction) projHint.textContent = row.dataset.projAction;
		});
	});

	setScene(currentScene);
	updatePlayUI();
</script>
