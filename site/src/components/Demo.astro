---
// Autoplaying demo for the home page: a muted looping recording of bmux in the
// dark theme, shown on a dark stage in both site themes. Rendered by
// `npm run screenshots` (scene "demo"). Honors reduced-motion by not autoplaying.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = (ext: string) => `${base}/demo/demo.${ext}`;
---
<figure class="home-demo">
	<video
		id="home-demo-video"
		autoplay
		muted
		loop
		playsinline
		preload="metadata"
		poster={`${base}/demo/demo-poster.png`}
		aria-label="Recording of bmux: attaching to a session, splitting a pane, switching sessions in the picker, searching scrollback and opening the project picker"
	>
		<source src={src('webm')} type="video/webm" />
		<source src={src('mp4')} type="video/mp4" />
	</video>
</figure>
<script>
	const video = document.getElementById('home-demo-video') as HTMLVideoElement | null;
	if (video && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		video.pause();
		video.controls = true;
	}
</script>
